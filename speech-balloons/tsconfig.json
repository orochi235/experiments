{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "useDefineForClassFields": true,
    "noEmit": true,
    // Weasel sources reference `process` (debug flags); resolve node's
    // ambient types from weasel's tree so this project doesn't need its
    // own @types/node copy.
    "types": ["node"],
    "typeRoots": ["./node_modules/@types", "../../weasel/node_modules/@types"],
    // Weasel-ui ships source-only, so tsc follows imports into the weasel
    // monorepo and needs every alias those sources use. This mirrors the
    // `paths` block in ../../weasel/tsconfig.json (same entries, prefixed) —
    // if weasel adds a top-level alias, mirror it here.
    //
    // react/react-dom are pinned to weasel's @types copies so both repos'
    // sources see ONE React type identity (the tsc analog of the vite
    // config's `dedupe: ['react', 'react-dom']`).
    "paths": {
      "react": ["../../weasel/node_modules/@types/react/index.d.ts"],
      "react/jsx-runtime": ["../../weasel/node_modules/@types/react/jsx-runtime.d.ts"],
      "react-dom": ["../../weasel/node_modules/@types/react-dom/index.d.ts"],
      "react-dom/client": ["../../weasel/node_modules/@types/react-dom/client.d.ts"],
      "@weasel-js/core": ["../../weasel/src/index.ts"],
      "@weasel-js/core/routing": ["../../weasel/src/tools/routing/index.ts"],
      "@weasel-js/core/*": ["../../weasel/src/*"],
      "@weasel-js/ui": ["../../weasel/packages/ui/src/index.ts"],
      "@weasel-js/svg": ["../../weasel/packages/svg/src/index.ts"],
      "@weasel-js/geom": ["../../weasel/packages/geom/src/index.ts"],
      "@weasel-js/geom/booleans": ["../../weasel/packages/geom/src/booleans/index.ts"],
      "@weasel-js/geom/*": ["../../weasel/packages/geom/src/*"],
      "@weasel-js/theme": ["../../weasel/packages/theme/src/index.ts"],
      "@weasel-js/theme/tokens.css": ["../../weasel/packages/theme/src/tokens.css"],
      "@weasel-js/gestures": ["../../weasel/packages/gestures/src/index.ts"],
      "@weasel-js/history": ["../../weasel/packages/history/src/index.ts"],
      "@weasel-js/modes": ["../../weasel/packages/modes/src/index.ts"],
      "@weasel-js/modes/presets/default": ["../../weasel/packages/modes/src/presets/default.ts"],
      "core/*": ["../../weasel/src/core/*"],
      "features/*": ["../../weasel/src/features/*"],
      "affordances/*": ["../../weasel/src/affordances/*"],
      "interactions/*": ["../../weasel/src/interactions/*"],
      "tools/*": ["../../weasel/src/tools/*"],
      "canvas/*": ["../../weasel/src/canvas/*"],
      "debug/*": ["../../weasel/src/debug/*"]
    }
  },
  "include": ["src"]
}
